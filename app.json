{
  "expo": {
    "name": "UpBeat Radio",
    "slug": "upbeat",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "upbeat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ]
      },
      "bundleIdentifier": "com.taygotexpo.upbeat"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07040f",
        "foregroundImage": "./assets/images/android-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.taygotexpo.upbeat"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01fb7b0f-8140-4418-ba73-c3c7c315bf0a"
      }
    },
    "owner": "taygotexpo"
  }
}
